{
  "realm": "ff-logistics",
  "enabled": true,
  "displayName": "FF Logistics Multi-Tenant IAM",
  "roles": {
    "realm": [
      {
        "name": "TENANT_ADMIN",
        "description": "Tenant Administrator"
      },
      {
        "name": "LOGISTICS_PLANNER",
        "description": "FF Nexus TMS & Intermodal Planner"
      },
      {
        "name": "WAREHOUSE_OPERATOR",
        "description": "FF CoreWMS & Flow Operator"
      },
      {
        "name": "DISPATCHER",
        "description": "FF GeoDispatch Route & Territory Dispatcher"
      },
      {
        "name": "REPORT_VIEWER",
        "description": "FF ControlTower BI Executive Dashboard Viewer"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ff-logistics-api",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8081/*"
      ],
      "protocolMappers": [
        {
          "name": "tenant-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "api-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ff-logistics-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8081"
      ]
    },
    {
      "clientId": "ff-logistics-service",
      "enabled": true,
      "publicClient": false,
      "secret": "ff-logistics-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "api-audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ff-logistics-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "integration-ff-eu-freight.northfield",
      "name": "Integration northfield (ff-eu-freight)",
      "enabled": true,
      "publicClient": false,
      "secret": "integration-northfield-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "tenant_id": "ff-eu-freight"
      },
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "ff-eu-freight",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ff-logistics-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "integration-ff-tr-distribution.corvane",
      "name": "Integration corvane (ff-tr-distribution)",
      "enabled": true,
      "publicClient": false,
      "secret": "integration-corvane-local-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "attributes": {
        "tenant_id": "ff-tr-distribution"
      },
      "protocolMappers": [
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "ff-tr-distribution",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ff-logistics-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "nexus.planner",
      "enabled": true,
      "email": "planner@ff-eu-freight.example",
      "firstName": "Nexus",
      "lastName": "Planner",
      "attributes": {
        "tenant_id": [
          "ff-eu-freight"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "fflogistics2026",
          "temporary": false
        }
      ],
      "realmRoles": [
        "TENANT_ADMIN",
        "LOGISTICS_PLANNER",
        "WAREHOUSE_OPERATOR",
        "REPORT_VIEWER"
      ]
    },
    {
      "username": "geodispatch.operator",
      "enabled": true,
      "email": "dispatch@ff-tr-distribution.example",
      "firstName": "GeoDispatch",
      "lastName": "Operator",
      "attributes": {
        "tenant_id": [
          "ff-tr-distribution"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "fflogistics2026",
          "temporary": false
        }
      ],
      "realmRoles": [
        "TENANT_ADMIN",
        "DISPATCHER",
        "LOGISTICS_PLANNER",
        "REPORT_VIEWER"
      ]
    },
    {
      "username": "service-account-integration-ff-eu-freight.northfield",
      "enabled": true,
      "serviceAccountClientId": "integration-ff-eu-freight.northfield",
      "realmRoles": [
        "LOGISTICS_PLANNER"
      ]
    },
    {
      "username": "service-account-integration-ff-tr-distribution.corvane",
      "enabled": true,
      "serviceAccountClientId": "integration-ff-tr-distribution.corvane",
      "realmRoles": [
        "LOGISTICS_PLANNER"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"tenant_id\",\"displayName\":\"Tenant\",\"validations\":{\"pattern\":{\"pattern\":\"^[a-z0-9][a-z0-9-]{1,63}$\",\"error-message\":\"A tenant id has 2 to 64 lower-case letters, digits or hyphens\"}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  }
}
